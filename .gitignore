# Ambiente
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Dados (microdados são grandes e baixados pelo pipeline)
data/raw/*
data/external/*
# Retrato dos dados externos do Mapa de Oportunidade (o OpenStreetMap muda todo dia)
!data/external/README.md
!data/external/osm_pizzarias_uf.csv
!data/external/osm_pizzarias_elementos.csv
!data/external/populacao_uf_censo2022.csv
data/processed/*
!data/**/.gitkeep

# Artefatos de modelo e experimentos
models/*
!models/.gitkeep
# O modelo final vai para o git: o commit registra o modelo congelado antes do teste
!models/occasion_model.joblib
!models/model_metadata.json
# Derivados do modelo congelado, gerados só com o treino (SHAP por fator)
!models/explicacao.json
# Contexto observado do Decision Engine, gerado só com o treino
!models/contexto_decisao.json
# Mapa de Oportunidade, gerado só com o treino e os dados externos versionados
!models/oportunidade.json
mlruns/
